{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowJs": true, "checkJs": false, "resolveJsonModule": true,
    "isolatedModules": true, "esModuleInterop": true, "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"],
  "exclude": ["src/service-worker.ts", "src/vault.worker.ts", "src/image.worker.ts"]
}
